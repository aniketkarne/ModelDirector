    LAYA --> SY["scores<br/>{overall}"]
    SL --> POL{Configured<br/>policy}
    SY --> POL
    POL -->|"cheapest_capable"| O["selected_model<br/>+ reason + cost"]
    POL -->|"highest_confidence"| O
    POL -->|"best_value"| O